# Healthcare Clinic Supabase & Security Configuration

# Supabase Credentials (obtain from your Supabase Project Settings -> API)
# In Vercel, link your Supabase project directly in the Vercel Marketplace or Project Settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-private-key

# Doctor PIN for posting health topics securely
DOCTOR_SECRET_PIN=doctor1234
